# 复制为 config/.env 后填写。config/.env 含 API Key，不要提交到 Git 或发给别人。

# RAGFlow 地址：默认 80 端口；若改过 docker/.env 中的 SVR_WEB_HTTP_PORT，这里要带端口号
RAGFLOW_BASE_URL=http://localhost

# 在 RAGFlow 界面：头像 → API → Create new key（ragflow-xxxx 开头）
RAGFLOW_API_KEY=

# 模型名格式：<ollama list 中的名称>@<厂商>，厂商在 RAGFlow 中为 Ollama
EMBED_MODEL=quentinz/bge-large-zh-v1.5@Ollama
CHAT_MODEL=qwen2.5:7b@Ollama

# 知识库和聊天助手名称
DATASET_NAME=AI课程知识库
CHAT_NAME=AI课程助教
